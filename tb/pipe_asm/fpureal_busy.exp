halt 0000058c
# plan M10 remainder: the $4160 BUSY frame (see the .s for what each case catches)
# four datatype faults (cases 1, 5, 6, 7); the last one's frame word is vector
# 55, format $3, with the NEXT instruction's PC -- and an address field of 0,
# because an immediate has no addressable operand (D19)
m32 00007000 00000004
m32 00007008 000030dc
m32 0000700c 0000058c
m32 00007010 00000000
# 1: the 25 longwords, absolutely.  FPIARCU (10) is the FADD at $500,
# CMDREG1B (16) its extension word $48A2 and CMDREG3B (13) the same command
# re-encoded ($0092, gen_except.sa's cmd1b -> cmd3b rule), STAG 4 = an
# extended denormal, FPTEMP the destination FP1 = 1.0, ETEMP the denormal
m32 00005400 41600000
m32 00005404 00000000
m32 00005408 00000000
m32 0000540c 00000000
