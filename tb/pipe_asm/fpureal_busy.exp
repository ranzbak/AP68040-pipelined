m32 00005460 00000100
# 2: FSAVE -(A7) walks A7 back by the whole 100 bytes, FRESTORE (A7)+ steps
# it forward by 100, and the restored state saves as the same 25 longwords
d3 00001f00
d4 00001e9c
d5 00001f00
m32 00007004 00000000
# 3: CU_SAVEPC $FE completed FADD from the frame: 2.25 + 1.5 = 3.75 in FP2
m32 00005500 40000000
m32 00005504 f0000000
m32 00005508 00000000
# 4: FMUL of 2^108 by the ETE15-extended denormal 2^-16438 = 2^-16330 in FP3
# (biased $0035; see the .s for the 68040's denormal exponent), and
# FRESTORE (A4)+ stepped A4 by 100
m32 0000550c 00350000
m32 00005510 80000000
m32 00005514 00000000
d7 00005264
