halt 000004a8
# plan M10.5, the NULL and IDLE state frames.
# 1: FSAVE before any floating-point instruction -- the NULL frame.  This is
# the longword Kickstart's probe at $F80DA4 reads to decide whether there is
# an FPU at all.
m32 00005100 00000000
# 2: after one FMOVE the unit has been used, so the IDLE frame
m32 00005104 41000000
# 3: FRESTORE of the NULL frame RESET the unit -- proved by FSAVE writing
# NULL again, which it cannot do unless fp_reset reached the unit
m32 00005108 00000000
# 4: ... and FRESTORE of the IDLE frame marks it used again
m32 0000510c 41000000
a1 00005110
# 5: FSAVE -(A7) steps A7 down by four and FRESTORE (A7)+ puts it back
d3 00001f00
d4 00001efc
d5 00001f00
# 6, 7: the $4130 frame is INSTALLED (M10.7) and A0 steps by the whole 52
# bytes; since the M10 remainder (2026-09-24) the $4160 BUSY frame is too, and
# A0 steps by 100 more: $5008 + 52 + 100.  No format error is taken.  (What a
# REFUSED frame does to An -- nothing, its update rides a dispatch that never
# happens -- is still this core's restart model, recorded in PLAN.md M10.5.)
m32 00007000 00000000
m32 00007004 00000000
m32 00007008 00000000
a0 000050a0
# 8: one unimplemented instruction (the FSIN), and the frame round trip is an
# identity -- thirteen longwords saved, restored and saved again with no
# mismatch.  The program does the comparison, so nothing here depends on what
# the payload MEANS.
m32 0000700c 00000002
# 10: FMOVECR reaches the unit and comes back as UNIMPLEMENTED -- vector 11
# with format $2 and the NEXT instruction's PC, the FPSP shape of D19, not
# M10.0's format $4.  The handler records the last one's frame word and PC.
m32 00007018 0000202c
m32 0000701c 000004a8
m32 00007014 00000000
# the whole frame, as lib/AP68040's fsave_unimp_word lays it out.  The values
# are predictable from the rule: cmd1 at index 4 is the FSIN's own extension
# word ($000E), cmd3 at index 1 is $0026, index 2 is the reserved longword,
# and fpt (7-9) and et (10-12) are the destination register's and the source
# operand's images -- both 1.0 here, because FSIN.X FP0 was given 1.0.
m32 00005400 41300000
m32 00005404 00260000
m32 00005408 00000000
m32 0000540c 00000000
m32 00005410 000e0000
m32 00005414 00000000
m32 00005418 00000000
m32 0000541c 3fff0000
m32 00005420 80000000
m32 00005424 00000000
m32 00005428 3fff0000
m32 0000542c 80000000
m32 00005430 00000000
# 9: and it was EXTRACTED, not copied -- a third FSAVE with no FRESTORE in
# between has nothing to save and writes IDLE
m32 00005480 41000000
