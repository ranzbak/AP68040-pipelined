halt 000005b8
# a3/a0 = $5000 is the operand address of cases 3, 5, 7 and 8.  An
# unimplemented FP instruction must never READ its operand, so a data read
# that touches it is a failure -- this is what stops the format $4 EA being
# obtained by letting the instruction fetch the operand.
noread 00005000
noread 00005001
noread 00005010
noread 00005020
# hand-written (plan M10.0): the reference core cannot generate this file --
# with AP040_HAS_FPU=0 it EXECUTES FSAVE/FRESTORE and stacks format $0 for the
# rest (divergence D12), so the expectations come from M68040UM Appendix A.5.2
# Table 12-1 and from D18.  Every longword after a case's tag is a DELTA the
# program computes against what the manual says, so a correct core writes zeros
# and no absolute address appears here.
m32 00007000 00000001
m32 00007004 00000000
m32 00007008 00000000
m32 0000700c 00000000
m32 00007010 00000000
m32 00007014 00000002
